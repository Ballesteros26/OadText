{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./test/tsconfig.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.eslint.json"
    }
  ],
  "compilerOptions": {
    "moduleDetection": "force",
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "src/*": ["./src/*"],
      "engine/*": ["./engine/*"],
      "assets/*": ["./assets/*"]
    }
  }
}
