{
  "extends": "./tsconfig.json",
  "include": [
    "./node_modules/@total-typescript/ts-reset/dist/recommended.d.ts",

    "eslint/**/*",
    "eslint.config.ts"
  ],
  "compilerOptions": {
    "module": "node20",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    "strict": true,
    "noImplicitAny": false,

    "types": ["node"],
    "lib": ["ES2024", "ESNext.Iterator"]
  }
}
