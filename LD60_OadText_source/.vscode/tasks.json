{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite",
      "icon": {
        "id": "zap",
      },
      "type": "npm",
      "script": "start",
      "group": "build",
      // detect when declaration files are generated
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          // should never match
          "regexp": "^\\[generate-declarations-plugin\\]$",
        },
        "background": {
          "activeOnStart": true,
          // should never match
          "beginsPattern": "^\\[generate-declarations-plugin\\]$",
          "endsPattern": "\\[generate-declarations-plugin\\] Type declarations generated$",
        },
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
      },
    },
    {
      "label": "tsc",
      "icon": {
        "id": "code",
      },
      "type": "npm",
      "script": "tsc",
      "group": "build",
      "dependsOn": ["vite"],
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": {
        "reveal": "never",
      },
      "runOptions": {
        "runOn": "folderOpen",
      },
    },
    {
      "label": "build",
      "icon": {
        "id": "symbol-method",
        "color": "terminal.ansiWhite",
      },
      "type": "npm",
      "script": "build",
      "group": "build",
    },
  ],
}
